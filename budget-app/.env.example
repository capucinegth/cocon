# Cocon — variables d'environnement (exemple, SANS aucune valeur réelle).
# Copier en .env.local pour le développement (.env* est ignoré par git) ;
# en ligne, les définir dans les réglages de l'hébergeur.
#
# Sans ces deux variables, Cocon démarre en MODE DÉMO (données fictives, rien n'est enregistré).

# URL du projet Supabase DÉDIÉ à Cocon (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=

# Clé PUBLIQUE uniquement : « publishable key » (sb_publishable_…) ou ancienne clé « anon ».
# Elle est visible dans le navigateur, c'est normal : la RLS protège les données.
# NE JAMAIS mettre ici la clé secrète / service_role : Cocon la refuse.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   (alternative, ancienne clé anon)

# Facultatif : forcer la démo même si Supabase est configuré (travail sur l'interface).
# NEXT_PUBLIC_COCON_DATA_SOURCE=demo

# --- Tests uniquement (jamais en production) -------------------------------------------
# PostgreSQL local VIERGE (15+, pas Supabase) pour les tests de base : TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres
# Pile Supabase LOCALE (`supabase start`) pour les tests d'intégration et de bout en bout :
# E2E_SUPABASE_URL=http://127.0.0.1:54321
# E2E_SUPABASE_ANON_KEY=
